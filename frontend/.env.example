# Copy to frontend/.env.local. Only VITE_* variables are exposed to the browser, so never put secrets here.

# Base path or absolute URL of the REST API. Keep "/api/v1" to use the Vite dev proxy.
VITE_API_BASE_URL=/api/v1

# Django dev server used by the Vite proxy (not exposed to the browser).
VITE_DEV_API_PROXY_TARGET=http://127.0.0.1:8000
