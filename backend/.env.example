# Copy to backend/.env and replace every placeholder. Never commit backend/.env.

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
# Optional separate signing key for JWTs; defaults to DJANGO_SECRET_KEY.
JWT_SIGNING_KEY=replace-with-a-different-long-random-secret

DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# postgres://USER:PASSWORD@HOST:PORT/DBNAME (URL-encode special characters in the password)
DATABASE_URL=postgres://zaylan:change-me@localhost:5432/zaylan

# Origins allowed to call the API with credentials and to use the refresh cookie.
FRONTEND_ORIGINS=http://localhost:5173
# Base URL used when building invitation links.
FRONTEND_URL=http://localhost:5173

ACCESS_TOKEN_LIFETIME_MINUTES=10
REFRESH_TOKEN_LIFETIME_DAYS=7
# Must be true in any environment served over HTTPS.
AUTH_COOKIE_SECURE=false
INVITATION_TTL_HOURS=72

# Production-only hardening (leave false for local HTTP development).
SECURE_SSL_REDIRECT=false
SECURE_HSTS_SECONDS=0
USE_X_FORWARDED_PROTO=false
LOG_LEVEL=INFO
